// 아래 풀이가 가장 짧은듯



#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

char* solution(const char* code) {
    int len = strlen(code);
    
    // 넉넉하게 고정 크기를 잡는 것보다 code 길이에 맞춰 할당하는 것이 안전합니다.
    // 널 문자('\0') 자리까지 고려해 +1을 해줍니다.
    char* answer = (char*)calloc(len + 1, sizeof(char));

malloc과는 다르게 calloc을 쓴다면 모든 메모리를 초기화한 상태에서 사용할 수 있다.
malloc은 할당만 한다. 즉 기존에 쓰던 쓰레기값이 남는다.

    int ansIdx = 0;
    int mode = 0;
    
    for(int i = 0; i < len; i++) { // 매번 strlen을 호출하지 않도록 변수 len 활용
        if(code[i] == '1') {
            mode = (mode + 1) % 2; // 안전하고 직관적인 mode 스위칭
        } else {
            if(mode == 0 && i % 2 == 0) {
                answer[ansIdx++] = code[i];
            } else if(mode == 1 && i % 2 == 1) {
                answer[ansIdx++] = code[i];
            }
        }
    }
    
    // 만약 빈 문자열이라면 기존 answer 메모리에 "EMPTY"를 덮어씁니다.
    if (ansIdx == 0) {
        strcpy(answer, "EMPTY");
    } else {
        answer[ansIdx] = '\0'; // 문자열의 끝을 명시 (calloc이라 이미 0이긴 하지만 안전 장치)
    }
    
    return answer;
}

