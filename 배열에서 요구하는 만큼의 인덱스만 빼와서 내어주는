#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

char* solution(const char* my_string, int indices[], size_t indices_len) {
    int lenmy = strlen(my_string);
    
    int lenres = lenmy - indices_len;
    char* answer = (char*)malloc(sizeof(char) * (lenres + 1));
    
    int *deleted = (int*)calloc(lenmy, sizeof(int));
    
    for (int i = 0; i < indices_len; i++) {deleted[indices[i]] = 1;}
    
    int j = 0;
    for (int i = 0; i < lenmy; i++) {
        if (deleted[i] == 0) {answer[j] = my_string[i]; j++;}
    } answer[j] = '\0'; free(deleted); return answer;}




이 코드는 배열은 처음 생성될때 기본적으로 각 자리수가 0이니 1인경우만 제외한다는것.
calloc⁠은 할당된 메모리의 모든 비트를 0으로 자동 초기화. 따라서 이 시점에서 ⁠deleted⁠ 배열의 모든 자리는 ⁠0⁠이 됨.


