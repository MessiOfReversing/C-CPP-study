char* solution(const char* my_string, int indices[], size_t indices_len) {
    int lenmy = strlen(my_string);
    char* answer = (char*)malloc(sizeof(char) * (lenmy - indices_len + 1));
    int* will_deleted = (int*)calloc(lenmy, sizeof(int));
    
    for(int i = 0; i < indices_len; i++){
        my_string[indices[i]] = 1;
    }
    
    int j = 0;
    for(int i = 0; i < lenmy; i++){
        if (will_deleted[i] == 0){answer[j] = my_string[i]; j++;}
    }
    
    return answer;
}












#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

char* solution(const char* my_string, int indices[], size_t indices_len) {
    int lenmy = strlen(my_string);
    char* answer = (char*)malloc(sizeof(char) * (lenmy - indices_len + 1));
    int* will_deleted = (int*)calloc(lenmy, sizeof(int));
    
    for(int i = 0; i < indices_len; i++){
        will_deleted[[indices[i]] = 1; // << will_deleted로 빼둬야지
    }
    
    int j = 0;
    for(int i = 0; i < lenmy; i++){
        if (will_deleted[i] == 0){answer[j] = my_string[i]; j++;}
    }
    answer[j] = '\0'; free(will_deleted); //<<< 이렇게 정리도 해야함
    return answer;
}
