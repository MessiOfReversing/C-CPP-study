대충 이렇게 모양만 잡아보려 했는데, 배열에서 뭔가를 빼본적은 없는것 같아서 실패했다.







#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int* solution(int arr[], size_t arr_len) {
    int* stk = (int*)malloc(sizeof(int) * arr_len);
    
    int count = 0; // stk에 쌓인 원소의 개수 (스택 포인터 역할과 비슷하다.)
    int i = 0;     // arr 값들을 따라 조사할 인덱스
    
    while (i < arr_len) {
        if (count == 0) {
            // 1. stk가 빈 배열일 때
            stk[count] = arr[i];
            count++;
            i++;
        } 
        else if (stk[count - 1] < arr[i]) {
            // 2. stk의 마지막 원소가 arr[i]보다 작을 때
            stk[count] = arr[i];
            count++;
            i++;
        } 
        else {
            // 3. stk의 마지막 원소가 arr[i]보다 크거나 같을 때
            // 값을 진짜 제거할 필요 없이, 개수(count)만 줄이면 다음 작업 때 덮어씌워집니다!
            count--; 
            // i는 증가시키지 않고 그대로 둡니다 (다음 루프에서 다시 비교해야 하므로)
        }
    }
    
    // 정확한 크기의 배열을 위해서 realloc을 사용해 크기를 조절
    stk = (int*)realloc(stk, sizeof(int) * count);
    
    return stk;
}





실제로 제출한건 이렇게 했음
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int* solution(int arr[], size_t arr_len){
    int* stk = (int*)malloc(sizeof(int) * arr_len);
    int count = 0;
    int i = 0;

    while(i < arr_len){
        if(count == 0){stk[count] = arr[i]; count++; i++;}

        else if(stk[count - 1] < arr[i]){stk[count] = arr[i]; count++; i++;}
        else{count--;}} return stk;}

stk만들고, count랑 i를 0으로 세팅마치고, arr_len보다 작은 인덱스동안 조사.
count가 0일때는 stk에 arr인덱스 따라서 들어가도록. i++로 올려서 해당 i인동안에만 이게 작동되게 해두는거임!
이거랑 안되는 경우로 만약 stk 값중 count 하나 앞의 값이 arr 인덱스보다 작다면 이전과 같은 동작하게 함.
이 둘다 아니라면 하나 깎음.

