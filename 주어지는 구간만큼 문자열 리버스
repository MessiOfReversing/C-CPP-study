#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h> // str어ㅉㅓ고들은 여기있으니까

char* solution(const char* my_string, int** queries, size_t queries_rows, size_t queries_cols) {
    int len = strlen(my_string);
    
    // 갖고싶은건 문자열이니 +1
    char* answer = (char*)malloc(sizeof(char) * (len + 1));
    
    // 일단 원본을 answer에
    strcpy(answer, my_string);
    
    // 캐릭터 납치, rows만 긁을거라서 사이즈도 rows로
    for (size_t i = 0; i < queries_rows; i++) {
        int s = queries[i][0]; // 시작 인덱스
        int e = queries[i][1]; // 끝 인덱스
        
        // 임시공간에 넣고 크로스로 슥슥. random은 mxxxxr -> moxxar -> modnar 이니까 이 방법이 맞다. 
        while (s < e) {
            char temp = answer[s];
            answer[s] = answer[e];
            answer[e] = temp;
            
            s++;
            e--;
        }
    }
    
    return answer;
}








