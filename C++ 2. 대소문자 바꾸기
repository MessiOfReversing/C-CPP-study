기존로직


#include <iostream>
#include <string>

using namespace std;

int main(void) {
    string strA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    string strB = "abcdefghijklmnopqrstuvwxyz";
    string str;
    cin >> str;
    
    int len = str.length();
    
    for(int i = 0; i < len; i++){
        // 입력받은 글자 str[i]를 strA와 strB의 모든 글자(26개)와 비교해야 합니다.
        for(int j = 0; j < 26; j++) {
            if(str[i] == strA[j]) {
                str[i] = strB[j];
                break; // 변환을 완료했으므로 안쪽 반복문 탈출
            }
            else if(str[i] == strB[j]) {
                str[i] = strA[j];
                break; // 변환을 완료했으므로 안쪽 반복문 탈출
            }
        }
    }
    
    cout << str;
    return 0;
}
