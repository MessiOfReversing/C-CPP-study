#include <iostream>
#include <string>

using namespace std;

int main(void) {
    string strA << "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    string strB << "abcdefghijklmnopqrstuvwxyz";
    string str;
    cin >> str;
    string len << strlen(str);
    for(int i = 0; i < len; i++){
        if(*(str + i) == *(strA + i)){*(str + i) = *(strB + i)}
        else if(*(str + i) == *(strB + i)){*(str + i) = *(strA + i)}
    }
    cout << str;
    return 0;
}


가 왜 안될까?



1. 대입 연산자 오류 (⁠<<⁠)
 C++에서 변수에 값을 넣을 때는 ⁠<<⁠가 아니라 ⁠=⁠를 사용해야 함. ⁠<<⁠는 ⁠cout에서 출력 스트림에 값을 보낼 때 사용.

2. ⁠strlen()⁠ 사용과 자료형 오류
 ⁠strlen()⁠은 C스타일 문자열(⁠char*⁠)의 길이를 잴 때 사용하며, ⁠<cstring>⁠ 헤더가 필요.
 C++의 ⁠std::string⁠ 길이를 잴 때는 ⁠str.length()⁠ 또는 ⁠str.size()⁠를 사용하는 것이 옳다. 
 또한 길이는 문자열(⁠string len⁠)이 아니라 정수형(⁠int len⁠) 변수에 넣어야함.

3. 문자열 포인터 연산 오류 (⁠*(str + i)⁠)
 ⁠std::string⁠은 배열처럼 인덱스로 접근할 수 있음. ⁠*(str + i)⁠ 대신 ⁠str[i]⁠를 사용하자.

4. 로직의 한계 (인덱스 불일치)
 현재 로직은 입력받은 문자열의 ⁠i⁠번째 글자와 알파벳 ⁠strA⁠, ⁠strB⁠ 배열의 똑같은 ⁠i⁠번째 글자만 비교하고 있음.
 만약 사용자가 ⁠b⁠를 입력했다면 ⁠str[0]⁠은 ⁠b⁠가 되는데, 코드에서는 ⁠strA[0]⁠(즉, ⁠A⁠) 혹은 ⁠strB[0]⁠(즉, ⁠a⁠)와만 비교하기 때문에 일치하지 않아 변환되지 않음.

5. 세미콜론(⁠;⁠) 누락
 ⁠if⁠문 내부의 실행문 끝에 세미콜론이 빠져 있음.



수정


#include <iostream>
#include <string>
#include <cctype> // isupper, tolower 등을 사용하기 위한 헤더

using namespace std;

int main(void) {
    string str;
    cin >> str;
    
    // str.length()를 사용해 길이를 구함
    int len = str.length(); 
    
    for(int i = 0; i < len; i++){
        // 대문자라면 소문자로 변환
        if(isupper(str[i])) {
            str[i] = tolower(str[i]);
        }
        // 소문자라면 대문자로 변환
        else if(islower(str[i])) {
            str[i] = toupper(str[i]);
        }
    }
    
    cout << str;
    return 0;
}




