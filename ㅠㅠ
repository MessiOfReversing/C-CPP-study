int* solution(int arr[], size_t arr_len, int** queries, size_t queries_rows, size_t queries_cols) {

    for(int i = 0; i < arr_len; i++){
        int j = 0;
        while(j < queries_cols;){
            queries[i][j];
            arr[i] = arr[j];
            arr[j] = arr[i];
        } j++;
    } int* answer = (int*)malloc(sizeof(int) * queries_cols); return answer;
