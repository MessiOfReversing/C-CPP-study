참 특수한 코드인데요, 아래같이 짜야 옳습니다.

#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int* solution(int arr[], size_t arr_len, int** queries, size_t queries_rows, size_t queries_cols) {
    // [rows(행)][cols(열)]임.
    // for로 queries를 순서대로 하나씩 확인
    for (size_t k = 0; k < queries_rows; k++) {
        // 바꾸고자 하는 두 인덱스 i와 j를 가져옴. cols는 항상 0이랑 1뿐인 항상 2인 상태이기 때문에 0이랑 1로만 둔다.
        int i = queries[k][0];
        int j = queries[k][1];
        
        // 이제 arr[i]와 arr[j]의 값을 서로 바꿈. 임시공간 만들어야함. 
        int temp = arr[i];
        arr[i] = arr[j];
        arr[j] = temp;
    }
    
    // 결과물(arr)을 담을 정답 배열을 arr_len 크기만큼 할당
    int* answer = (int*)malloc(sizeof(int) * arr_len);
    
    // 변환이 완료된 arr의 값들을 answer에 복사
    for (size_t i = 0; i < arr_len; i++) {
        answer[i] = arr[i];
    }
    
    return answer;
}



