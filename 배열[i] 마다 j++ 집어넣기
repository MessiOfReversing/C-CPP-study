이렇게 해도되고



#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int* solution(int n, int k) {
    // 1부터 n까지 k의 배수의 개수는 정확히 n / k 개입니다.
    int count = n / k;
    
    // 정확한 개수만큼 메모리 할당
    int* answer = (int*)malloc(sizeof(int) * count);
    
    // i는 0부터 count - 1까지 증가하며 배열의 인덱스로 사용됩니다.
    for (int i = 0; i < count; i++) {
        // i가 0일 때 (0 + 1) * k = k
        // i가 1일 때 (1 + 1) * k = 2k ...
        answer[i] = k * (i + 1);
    }
    
    return answer;
}


이것도 됩니다잉
