#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int solution(int n) {
  int answer = 0;  
  if (n % 2 == 1 && n > 0){  
   for (int i=1; i <= n; i += 2){
      answer += i;
      }
  }
  if (n % 2 == 0 && n > 0){
   for (int i=0; i <= n; i += 2){
      answer += (i * i);
      }   
  }    
return answer;
}




/// 이게 훨씬 더 나은듯

#include <stdio.h>

int solution(int n) {
    // 0 이하의 예외 처리
    if (n <= 0) return 0;

    int half = n / 2;

    // Case 1: n이 홀수일 때 (비트 연산 n & 1 사용)
    // 1부터 n까지의 홀수의 합 공식: (개수)^2
    if (n & 1) {
        int count = half + 1;
        return count * count;
    }

    // Case 2: n이 짝수일 때
    // 2^2 + 4^2 + ... + n^2 연속된 짝수 제곱의 합 공식 변형
    // 원본 공식: 2 * half * (half + 1) * (2 * half + 1) / 3
    return 2 * half * (half + 1) * (2 * half + 1) / 3;
}


컴퓨터는 숫자를 2진수로 저장함. 홀수는 2진수로 표현했을 때 맨 마지막 자리가 항상 1임.

e.g.
5⁠ --> ⁠101⁠
⁠1 --> ⁠001⁠
5 & 1⁠을 하면 ⁠101 & 001 = 001⁠ (참)
