#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int solution(int n) {
  int answer = 0;  
  if (n % 2 == 1 && n > 0){  
   for (int i=1; i <= n; i += 2){
      answer += i;
      }
  }
  if (n % 2 == 0 && n > 0){
   for (int i=0; i <= n; i += 2){
      answer += (i * i);
      }   
  }    
return answer;
}




