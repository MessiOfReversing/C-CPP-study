#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int solution(int a, int b, int c, int d) {
    // for compare
    int ab_max = a > b ? a : b;
    int ab_min = a < b ? a : b;
    int ac_max = a > c ? a : c;
    int ac_min = a < c ? a : c;
    int ad_max = a > d ? a : d;
    int ad_min = a < d ? a : d;
    int bc_max = b > c ? b : c;
    int bc_min = b < c ? b : c;

    // minimum
    int cmp = a > b ? b : a;
    cmp = cmp > c ? c : cmp;
    cmp = cmp > d ? d : cmp;

    // case10 fix
    int case10 = (a != b && a != c && a != d) && (b != c && b != d && c != d) ? cmp : 0;
    if (case10 != 0) {return cmp;}

    // (p + q) * |p - q| << new fix
    int fix3 = (a == d && b == c && a != b) ? (a + b) * (ab_max - ab_min) : case10; if (fix3 != case10) { return fix3; }

    // a=c, b=d
    int fix2 = (a == c && b == d && a != b) ? (a + b) * (ab_max - ab_min) : fix3; if (fix2 != fix3) { return fix2; }
    // a=b, c=d
    int fix1 = (a == b && c == d && a != c) ? (a + c) * (ac_max - ac_min) : fix2; if (fix1 != fix2) { return fix1; }

    // x=y, (!= p, q)
    int case9 = (a == d && a != b && a != c && b != c) ? b * c : case10; if (case9 != case10) { return case9; }
    int case8 = (c == d && c != a && c != b && a != b) ? a * b : case9;  if (case8 != case9) { return case8; }
    int fix7to8 = (b == d && b != a && b != c && a != c) ? a * c : case8; if (fix7to8 != case8) { return fix7to8; }
    int case7 = (b == c && b != a && b != d && a != d) ? a * d : fix7to8; if (case7 != fix7to8) { return case7; }
    int fix6to7 = (a == c && a != b && a != d && b != d) ? b * d : case7; if (fix6to7 != case7) { return fix6to7; }
    int case6 = (a == b && a != c && a != d && c != d) ? c * d : fix6to7; if (case6 != fix6to7) { return case6; }

    // x=y=z, not a cases
    int case5 = (b == c && c == d && b != a) ? (10 * b + a) * (10 * b + a) : case6; if (case5 != case6) { return case5; }
    int case4 = (a == c && c == d && a != b) ? (10 * a + b) * (10 * a + b) : case5; if (case4 != case5) { return case4; }
    int case3 = (a == b && b == d && a != c) ? (10 * a + c) * (10 * a + c) : case4; if (case3 != case4) { return case3; }
    int case2 = (a == b && b == c && a != d) ? (10 * a + d) * (10 * a + d) : case3; if (case2 != case3) { return case2; }

    // a=b=c=d case
    int case1 = (a == b && b == c && c == d) ? 1111 * a : case2; 
    return case1;
}


