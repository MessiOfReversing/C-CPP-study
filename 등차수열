#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

// included_len은 배열 included의 길이입니다.
int solution(int a, int d, bool included[], size_t included_len) {
    int answer = 0;

    for (size_t i = 0; i < included_len; i++) {
        // included[i]가 true일 때만 누적해서 더해줍니다.
        if (included[i] == true) {
            answer += (a + d * i);
        }
    }

    return answer;
}

