#include <vector>
#include <algorithm> // max 함수 사용

using namespace std;

int solution(vector<int> num_list) {
    int even_sum = 0;
    int odd_sum = 0;
    
    for (int i = 0; i < num_list.size(); ++i) {
        if (i % 2 == 0) {
            even_sum += num_list[i];
        } else {
            odd_sum += num_list[i];
        }
    }
    
    // 삼항 연산자 대신 std::max를 쓰면 코드가 더 깔끔해집니다.
    return max(even_sum, odd_sum);
}



