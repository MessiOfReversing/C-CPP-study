#include <vector>
#include <algorithm>

using namespace std;

int solution(vector<int> num_list) {
    int even_sum = 0;
    int odd_sum = 0;
    bool is_even = true; // 0번째 인덱스는 짝수번째로 시작
    
    for (int num : num_list) {
        if (is_even) {
            even_sum += num;
        } else {
            odd_sum += num;
        }
        is_even = !is_even; // 차례대로 true/false 교체
    }
    
    return max(even_sum, odd_sum);
}


