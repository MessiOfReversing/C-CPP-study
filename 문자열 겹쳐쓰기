// 2번 방법
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

// 파라미터로 주어지는 문자열은 const로 주어집니다. 변경하려면 문자열을 복사해서 사용하세요.
char* solution(const char* my_string, const char* overwrite_string, int s) {
    // return 값은 malloc 등 동적 할당을 사용해주세요. 할당 길이는 상황에 맞게 변경해주세요.

    int len = strlen(my_string);
    char* answer = (char*)malloc(len + 1);

    strcpy(answer, my_string);

    len = strlen(overwrite_string);
    memcpy(&answer[s], overwrite_string, len);
 return answer;
}
// 

이게 프로그래머스 문제에서 가장 위에 있던 풀이였는데, memcpy를 사용했음.
len = strlen(overwrite_string);
memcpy(&answer[s], overwrite_string, len);
에서 &answer[s]는 s번째 인덱스 글자가 있는 곳의 주소, 즉 "여기서부터 overwrite string을 len만큼 적어라" 라는 의미.

char* answer = (char*)malloc(len + 1);에서는 malloc으로 len에 null자리까지 감안한 len + 1만큼 동적할당. 공간 마련하고서 char*로 그것이 캐릭터 공간임을 적어두는 것. char* answer를 통해서 answer라는 포인터 선언한것. 





// 3번 방법
char* solution(const char* my_string, const char* overwrite_string, int s) {
    int my_len = strlen(my_string);
    int over_len = strlen(overwrite_string);
    
    char* answer = (char*)malloc(my_len + 1);
    
    // 1. s 전까지는 원래 문자 그대로 복사
    for(int i = 0; i < s; i++) {
        answer[i] = my_string[i];
    }
    
    // 2. s부터는 overwrite_string을 복사
    for(int i = 0; i < over_len; i++) {
        answer[s + i] = overwrite_string[i];
    }
    
    // 3. overwrite_string이 끝난 지점부터 나머지 원래 문자 복사
    for(int i = s + over_len; i < my_len; i++) {
        answer[i] = my_string[i];
    }
    
    // 문자열의 끝을 알리는 널 문자('\0')를 반드시 넣어줍니다.
    answer[my_len] = '\0'; 
    
    return answer;
}
