// 1번 방법
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

char* solution(const char* my_string, const char* overwrite_string, int s) {
    char* answer = (char*)malloc(strlen(my_string) + 1);
    int index = 0; 
    
    for(int i = 0; i < s; i++) {
        answer[index++] = my_string[i];
    }
    
이렇게 my string에서 my string[0] 즉 첫째 캐릭터부터 my string[s], 즉 s-1 번째 캐릭터를 받고 answer에 집어넣는 방식
i++ 통해서 계속 증가시킨 값을 answer[]에 넣어줘야하니 내부 인자도 같이 증가하면서 증가하는 만큼 매번 할당 받아주도록 index++로 적어줘야함.


    for(int i = 0; i < strlen(overwrite_string); i++) {
        answer[index++] = overwrite_string[i];
    }

그 뒤로 붙일 overwrite string인데, 이건 통째로 갖다 넣어야 하니까 0부터 길이만큼 넣어줘야함.

    for(int i = s + strlen(overwrite_string); i < strlen(my_string); i++) {
        answer[index++] = my_string[i];
    }
overwrite string 추가한 뒤에도 남는 my string 캐릭터가 있다면 그게 출력되도록함.

    
    answer[index] = '\0';
문자열이 끝나는곳에 null이 들어가도록 해줌

    return answer;
완성한 answer을 반환시키면 완성.
}
