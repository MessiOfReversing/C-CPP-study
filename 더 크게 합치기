#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int solution(int a, int b) {
    
    int lena = strlen(a);
    int lenb = strlen(b);
    
    char stra[10050] = &a;
    char strb[10050] = &b;

    int* answer1 = (int*)malloc(memset(a + lena, b , lenb)));
    int* answer2 = (int*)malloc(memset(b + lenb, a , lena)));
    
    if(answer1 > answer2){answer = answer1}
    else {answer=answer2}
    
    answer[lena + lenb + 1] = '\0';
    return answer;
}
