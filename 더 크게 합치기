// 개선 2
#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>

int solution(int a, int b) {
    // b의 자릿수만큼 10을 곱하기 위한 변수
    int pow_b = 1;
    int temp_b = b;
    while (temp_b > 0) {
        pow_b *= 10;
        temp_b /= 10;
    }
    
    // a의 자릿수만큼 10을 곱하기 위한 변수
    int pow_a = 1;
    int temp_a = a;
    while (temp_a > 0) {
        pow_a *= 10;
        temp_a /= 10;
    }
    
    // 이어 붙이기
    int ab = a * pow_b + b;
    int ba = b * pow_a + a;
    
    return ab >= ba ? ab : ba;
}
